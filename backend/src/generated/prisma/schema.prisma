datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String?
  googleId  String?  @unique
  createdAt DateTime @default(now())

  courses     Course[]     @relation("UserCourses")
  exercises   Exercise[]   @relation("UserExercises")
  submissions Submission[] @relation("UserSubmissions")
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String
  icon     String?
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  courses Course[]
}

model Course {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  official  Boolean  @default(false)
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation("UserCourses", fields: [authorId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  exercises CourseExercise[]
}

model CourseExercise {
  id         String   @id @default(uuid())
  courseId   String
  exerciseId String
  course     Course   @relation(fields: [courseId], references: [id])
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
}

model Exercise {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  statement   String
  codeStub    String?
  language    String   @default("python")
  timeoutSec  Int      @default(3)
  official    Boolean  @default(false)
  createdAt   DateTime @default(now())
  allowedLibs String[] @default([])

  authorId String
  author   User   @relation("UserExercises", fields: [authorId], references: [id])

  tests       ExerciseTest[]
  submissions Submission[]

  courses CourseExercise[]
}

model ExerciseTest {
  id         String   @id @default(uuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  idx        Int
  input      String
  expected   String
}

model Submission {
  id         String   @id @default(uuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  authorId   String?
  author     User?    @relation("UserSubmissions", fields: [authorId], references: [id])
  createdAt  DateTime @default(now())
  status     String
  resultJson String
}
